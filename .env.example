# Render
PORT=10000
NODE_ENV=production

# PostgreSQL — use a free Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

# Max upload in MB. Cloudinary Free has its own per-file limits.
MAX_FILE_SIZE=100

# Cloudinary Free — media storage for avatars, photos, video and voice messages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
